{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": "(.*text/markdown.*)" }],
      "destination": "/api/content?page=home"
    },
    {
      "source": "/about",
      "has": [{ "type": "header", "key": "accept", "value": "(.*text/markdown.*)" }],
      "destination": "/api/content?page=about"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "accept", "value": "(.*text/markdown.*)" }],
      "destination": "/api/content?page=contact"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "accept", "value": "(.*text/markdown.*)" }],
      "destination": "/api/content?page=privacy"
    },
    {
      "source": "/terms",
      "has": [{ "type": "header", "key": "accept", "value": "(.*text/markdown.*)" }],
      "destination": "/api/content?page=terms"
    },

    { "source": "/index.md", "destination": "/api/content?page=home&ext=md" },
    { "source": "/about.md", "destination": "/api/content?page=about&ext=md" },
    { "source": "/contact.md", "destination": "/api/content?page=contact&ext=md" },
    { "source": "/privacy.md", "destination": "/api/content?page=privacy&ext=md" },
    { "source": "/terms.md", "destination": "/api/content?page=terms&ext=md" },

    { "source": "/", "destination": "/pages/home.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },

    { "source": "/(.*)", "destination": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com; media-src 'self' blob:; connect-src 'self' data: blob: https://fonts.googleapis.com https://fonts.gstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Link", "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Link", "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Link", "value": "</contact.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Link", "value": "</privacy.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Link", "value": "</terms.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(llms.txt|sitemap.xml|robots.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, must-revalidate" }
      ]
    }
  ]
}
